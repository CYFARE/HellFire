ac_add_options --enable-application=browser
ac_add_options --disable-artifact-builds
ac_add_options --enable-bootstrap
ac_add_options --enable-stdcxx-compat

ac_add_options --enable-linker=lld
ac_add_options --enable-lto=full,cross
ac_add_options MOZ_PGO=1

ac_add_options --as-milestone=release
ac_add_options --enable-release
ac_add_options --enable-optimize=-O3
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-debug-js-modules
ac_add_options --disable-tests
ac_add_options --disable-warnings-as-errors
ac_add_options --enable-rust-simd
ac_add_options --enable-jemalloc
ac_add_options --disable-phc
ac_add_options --disable-replace-malloc
ac_add_options --disable-geckodriver
ac_add_options --without-wasm-sandboxed-libraries

ac_add_options --enable-hardening
ac_add_options --enable-sandbox
ac_add_options --disable-parental-controls
ac_add_options --disable-crashreporter
ac_add_options --disable-updater

ac_add_options --enable-install-strip

export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_DEBUG=false
export CARGO_PROFILE_RELEASE_OVERFLOW_CHECKS=false
export RUSTFLAGS="-C target-cpu=x86-64-v3 -C target-feature=+aes -C debuginfo=0 -C force-frame-pointers=no"

export CFLAGS="-O3 -march=x86-64-v3 -maes -fno-semantic-interposition -fomit-frame-pointer -fdata-sections -ffunction-sections -pipe -fno-common -fno-plt"

export CXXFLAGS="-O3 -march=x86-64-v3 -maes -fno-semantic-interposition -fomit-frame-pointer -fdata-sections -ffunction-sections -pipe -fno-common -fno-plt"

export LDFLAGS="-Wl,-O2 -Wl,--lto-O3 -Wl,--gc-sections -Wl,--icf=safe -Wl,-z,keep-text-section-prefix -Wl,-z,now -Wl,-z,relro -Wl,--as-needed -Wl,--hash-style=gnu"

mk_add_options MOZ_MAKE_FLAGS="-j32"
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-opt
mk_add_options AUTOCLOBBER=1

